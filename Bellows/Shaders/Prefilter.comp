#version 460
#extension GL_GOOGLE_include_directive : require
// GGX prefiltered specular environment (split-sum approximation), with filtered importance sampling.

#include "CubeMap.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, std140) uniform Constants
{
	vec4 Params;	// x = face size of this mip, y = roughness, z = source face size, w = sample count
} u_Constants;

layout(set = 0, binding = 1) uniform textureCube u_Source;
layout(set = 0, binding = 2) uniform sampler s_Linear;
layout(set = 0, binding = 3, rgba16f) uniform writeonly image2DArray o_Cube;

float DistributionGGX(float NdotH, float roughness)
{
	float alpha = roughness * roughness;
	float alpha2 = alpha * alpha;
	float denominator = NdotH * NdotH * (alpha2 - 1.0) + 1.0;
	return alpha2 / (PI * denominator * denominator);
}

void main()
{
	uvec3 id = gl_GlobalInvocationID;
	float size = u_Constants.Params.x;
	if (float(id.x) >= size || float(id.y) >= size)
		return;

	vec3 N = CubeDirection(id, size);
	vec3 V = N;
	float roughness = u_Constants.Params.y;
	float sourceSize = u_Constants.Params.z;
	uint sampleCount = uint(u_Constants.Params.w);

	if (roughness < 0.001)
	{
		imageStore(o_Cube, ivec3(id), vec4(textureLod(samplerCube(u_Source, s_Linear), N, 0.0).rgb, 1.0));
		return;
	}

	vec3 color = vec3(0.0);
	float totalWeight = 0.0;
	for (uint i = 0u; i < sampleCount; i++)
	{
		vec2 xi = Hammersley(i, sampleCount);
		vec3 H = ImportanceSampleGGX(xi, N, roughness);
		vec3 L = normalize(2.0 * dot(V, H) * H - V);
		float NdotL = max(dot(N, L), 0.0);
		if (NdotL <= 0.0)
			continue;

		float NdotH = max(dot(N, H), 0.0);
		float HdotV = max(dot(H, V), 0.0);
		float pdf = DistributionGGX(NdotH, roughness) * NdotH / (4.0 * HdotV) + 0.0001;
		float texelSolidAngle = 4.0 * PI / (6.0 * sourceSize * sourceSize);
		float sampleSolidAngle = 1.0 / (float(sampleCount) * pdf + 0.0001);
		float mip = 0.5 * log2(sampleSolidAngle / texelSolidAngle) + 1.0;

		color += textureLod(samplerCube(u_Source, s_Linear), L, max(mip, 0.0)).rgb * NdotL;
		totalWeight += NdotL;
	}
	imageStore(o_Cube, ivec3(id), vec4(color / max(totalWeight, 1e-4), 1.0));
}
