#version 460
#extension GL_GOOGLE_include_directive : require
// Diffuse irradiance convolution of an environment cube map.

#include "CubeMap.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, std140) uniform Constants
{
	vec4 Params;	// x = face size, y = source mip used for sampling
} u_Constants;

layout(set = 0, binding = 1) uniform textureCube u_Source;
layout(set = 0, binding = 2) uniform sampler s_Linear;
layout(set = 0, binding = 3, rgba16f) uniform writeonly image2DArray o_Cube;

void main()
{
	uvec3 id = gl_GlobalInvocationID;
	float size = u_Constants.Params.x;
	if (float(id.x) >= size || float(id.y) >= size)
		return;

	vec3 N = CubeDirection(id, size);
	vec3 up = abs(N.y) < 0.999 ? vec3(0.0, 1.0, 0.0) : vec3(0.0, 0.0, 1.0);
	vec3 right = normalize(cross(up, N));
	up = cross(N, right);

	const float sampleDelta = 0.05;
	vec3 irradiance = vec3(0.0);
	float sampleCount = 0.0;
	for (float phi = 0.0; phi < 2.0 * PI; phi += sampleDelta)
	{
		for (float theta = 0.0; theta < 0.5 * PI; theta += sampleDelta)
		{
			vec3 tangentSample = vec3(sin(theta) * cos(phi), sin(theta) * sin(phi), cos(theta));
			vec3 sampleDirection = tangentSample.x * right + tangentSample.y * up + tangentSample.z * N;
			irradiance += textureLod(samplerCube(u_Source, s_Linear), sampleDirection, u_Constants.Params.y).rgb * cos(theta) * sin(theta);
			sampleCount += 1.0;
		}
	}
	irradiance = PI * irradiance / max(sampleCount, 1.0);
	imageStore(o_Cube, ivec3(id), vec4(irradiance, 1.0));
}
