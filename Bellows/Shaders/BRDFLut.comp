#version 460
#extension GL_GOOGLE_include_directive : require
// Split-sum environment BRDF lookup table (scale, bias) indexed by (NdotV, roughness).

#include "CubeMap.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, std140) uniform Constants
{
	vec4 Params;	// x = size
} u_Constants;

layout(set = 0, binding = 3, rg16f) uniform writeonly image2D o_Lut;

float GeometrySchlickGGX(float NdotV, float roughness)
{
	float k = (roughness * roughness) / 2.0;
	return NdotV / (NdotV * (1.0 - k) + k);
}

void main()
{
	uvec3 id = gl_GlobalInvocationID;
	float size = u_Constants.Params.x;
	if (float(id.x) >= size || float(id.y) >= size)
		return;

	float NdotV = max((float(id.x) + 0.5) / size, 1e-3);
	float roughness = (float(id.y) + 0.5) / size;

	vec3 V = vec3(sqrt(1.0 - NdotV * NdotV), 0.0, NdotV);
	vec3 N = vec3(0.0, 0.0, 1.0);

	const uint sampleCount = 512u;
	float scale = 0.0;
	float bias = 0.0;
	for (uint i = 0u; i < sampleCount; i++)
	{
		vec2 xi = Hammersley(i, sampleCount);
		vec3 H = ImportanceSampleGGX(xi, N, roughness);
		vec3 L = normalize(2.0 * dot(V, H) * H - V);

		float NdotL = max(L.z, 0.0);
		float NdotH = max(H.z, 0.0);
		float VdotH = max(dot(V, H), 0.0);
		if (NdotL > 0.0)
		{
			float G = GeometrySchlickGGX(NdotV, roughness) * GeometrySchlickGGX(NdotL, roughness);
			float visibility = (G * VdotH) / max(NdotH * NdotV, 1e-5);
			float Fc = pow(1.0 - VdotH, 5.0);
			scale += (1.0 - Fc) * visibility;
			bias += Fc * visibility;
		}
	}
	imageStore(o_Lut, ivec2(id.xy), vec4(scale / float(sampleCount), bias / float(sampleCount), 0.0, 1.0));
}
