#version 460
#extension GL_GOOGLE_include_directive : require
// Generates the next mip of a cube map with a 2x2 box filter.

#include "CubeMap.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, std140) uniform Constants
{
	vec4 Params;	// x = destination size, y = source mip level
} u_Constants;

layout(set = 0, binding = 1) uniform textureCube u_Source;
layout(set = 0, binding = 2) uniform sampler s_Linear;
layout(set = 0, binding = 3, rgba16f) uniform writeonly image2DArray o_Cube;

void main()
{
	uvec3 id = gl_GlobalInvocationID;
	float size = u_Constants.Params.x;
	if (float(id.x) >= size || float(id.y) >= size)
		return;

	vec3 direction = CubeDirection(id, size);
	vec3 color = textureLod(samplerCube(u_Source, s_Linear), direction, u_Constants.Params.y).rgb;
	imageStore(o_Cube, ivec3(id), vec4(color, 1.0));
}
