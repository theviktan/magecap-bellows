# Exercises the MageCap Bellows engine API from ForgeScript inside the FeatureTest scene.
#
# Attached to the "ForgeScript Test Runner" entity. It runs first, while the Python test
# (FeatureTest.py) waits; when it is done it renames its entity to
#     ForgeScript Test Passed (N checks)    or    ForgeScript Test Failed (N of M checks)
# and FeatureTest.py includes that result in the final "FEATURE TEST PASSED" line.

set label to "default"          # FeatureTest sets this to "authored" in the scene

set checks to 0
set failures to []
set events to []

# -- Helpers -----------------------------------------------------------------------------

function check(condition, description)
	add 1 to checks
	if not condition then
		add description to failures
		say "FeatureTest.forge: FAILED - {description}"
	end
end

# True when two numbers, vectors or lists of numbers (colors) are equal within a tolerance.
function near(a, b, tolerance)
	if a is a number then return abs(a - b) is at most tolerance end
	if a is a vector then return distance(a, b) is at most tolerance end
	if length(a) is not length(b) then return false end
	for i from 1 to length(a)
		if abs(a[i] - b[i]) is above tolerance then return false end
	end
	return true
end

function close(a, b)
	return near(a, b, 0.0001)
end

# True when calling 'action' fails with an error.
function fails(action)
	try
		action()
	catch
		return true
	end
	return false
end

# Waits until 'condition' is true, or until 'seconds' have passed.
function wait_for(condition, seconds)
	set deadline to time() + seconds
	until condition() or time() is above deadline
		wait
	end
end

# -- Events from the engine --------------------------------------------------------------

when update with delta
	if delta is a number and not events.contains("update") then add "update" to events end
end

when physics update with delta
	if delta is above 0 and not events.contains("physics") then add "physics" to events end
end

# -- The test sequence -------------------------------------------------------------------

function test_basics()
	check(label is "authored", "Inspector fields from the scene replace the script's value ({label})")
	check(self is find_entity("ForgeScript Test Runner"), "self is the entity the script is attached to")
	check(my has_component("Script") and my get_component("Script").path is "Scripts/FeatureTest.forge", "the script component")
	check(is_playing() and scene_name() is "FeatureTest", "is_playing and scene_name")
	check(delta_time() is at least 0 and time() is at least 0 and frame() is at least 0, "time functions")
	check(not is_key_down("Space") and not is_key_pressed("W") and not is_mouse_down("Right"), "input queries by name")
	check(fails(function() is_key_down("NotAKey") end), "unknown key names are rejected")
	check(viewport_size().x is above 0 and mouse_position() is a vector, "viewport and mouse queries")
	check(near(get_gravity(), vector(0, -9.81, 0), 0.001), "default gravity ({get_gravity()})")
end

function test_scene_queries()
	for each name in ["Main Camera", "Sun", "Sky", "Ground", "Water Bottle", "Cannon", "Trigger Zone"]
		check(find_entity(name) is not nothing, "authored entity '{name}' exists")
	end
	check(find_entity("Does Not Exist") is nothing, "find_entity gives nothing for missing names")
	set cameras to get_entities("Camera")
	check(length(cameras) is 1 and primary_camera() is cameras[1], "get_entities and primary_camera")
	check(get_entity(cameras[1].id) is cameras[1], "get_entity by id")
	check(length(get_entities()) is above length(get_entities("PointLight")), "get_entities without a filter")
end

function test_entities()
	set holder to create_entity("Forge Parent")
	set child to create_entity("Forge Child", holder)
	check(child.parent is holder and holder.children[1] is child, "parenting")
	check(holder.find_child("Forge Child") is child and holder.valid, "find_child and valid")
	check(fails(function() set holder.parent to child end), "hierarchy cycles are rejected")
	set holder.name to "Forge Renamed"
	check(holder.name is "Forge Renamed" and text(holder) contains "Forge Renamed", "renaming")

	set holder.position to vector(1, 2, 3)
	set child.local_position to vector(0, 1, 0)
	check(close(child.position, vector(1, 3, 3)), "child world position follows the parent")
	set holder.position.x to 4
	add 1 to holder.position.y
	check(close(holder.position, vector(4, 3, 3)), "changing one part of a position")
	set holder.rotation to vector(0, 90, 0)
	check(close(holder.forward, vector(-1, 0, 0)), "rotation in degrees and forward")
	set holder.rotation to vector()
	holder.rotate(vector(0, 0, 90))
	check(near(holder.rotation, vector(0, 0, 90), 0.001), "rotate")
	holder.translate(vector(1, 0, 0))
	check(close(holder.position, vector(5, 3, 3)), "translate")
	holder.look_at(vector(5, 3, -10))
	check(close(holder.forward, vector(0, 0, -1)), "look_at")
	set holder.transform.scale to vector(1, 2, 1)
	check(close(holder.scale, vector(1, 2, 1)), "Transform component")

	set child.parent to nothing
	check(child.parent is nothing and holder.children.is_empty(), "unparenting")
	child.destroy()
	destroy(holder)
end

function test_components()
	set thing to create_entity("Forge Components")
	check(thing.components.join(", ") is "Transform", "new entities only have a Transform")
	check(fails(function() thing.add_component("NotAComponent") end), "unknown components are rejected")

	set renderer to thing.add_component("MeshRenderer")
	set renderer.mesh to "Builtin/Sphere"
	set renderer.cast_shadows to false
	check(renderer.mesh is "Builtin/Sphere" and not renderer.cast_shadows, "MeshRenderer properties")
	set renderer.color to [0, 1, 0, 1]
	check(close(renderer.color, [0, 1, 0, 1]), "MeshRenderer color")

	set light to thing.add_component("PointLight")
	set light.color to vector(0, 1, 0)
	set light.range to 4
	check(close(light.color, vector(0, 1, 0)) and light.range is 4, "PointLight properties")

	set body to thing.add_component("RigidBody")
	set body.type to "Kinematic"
	set body.mass to 3
	check(body.type is "Kinematic" and body.mass is 3, "RigidBody properties")
	set sphere to thing.add_component("SphereCollider")
	set sphere.radius to 0.75
	check(sphere.radius is 0.75, "SphereCollider properties")
	set source to thing.add_component("AudioSource")
	set source.clip to "Audio/Chime.wav"
	check(source.clip is "Audio/Chime.wav", "AudioSource properties")
	set source.bus to "Music"
	check(source.bus is "Music", "AudioSource bus")
	check(fails(function() set source.bus to "Nowhere" end), "unknown buses are rejected for sources")

	set agent to thing.add_component("NavAgent")
	set agent.speed to 2
	set agent.base_offset to 0.5
	check(agent.speed is 2 and agent.base_offset is 0.5 and agent.avoid_others, "NavAgent properties")
	check(fails(function() set agent.speed to 500 end), "a NavAgent's speed is held to its range")

	set sparks to thing.add_component("ParticleEmitter")
	set sparks.shape to "sphere"
	set sparks.blend to "alpha"
	set sparks.burst to 30
	set sparks.start_color to [1, 0.5, 0, 1]
	check(sparks.shape is "sphere" and sparks.blend is "alpha" and sparks.burst is 30 and sparks.is_playing, "ParticleEmitter properties")
	check(fails(function() set sparks.shape to "donut" end) and fails(function() set sparks.rate to -1 end), "a ParticleEmitter's values are checked")
	set sparks.size_curve to [[0, 0], [0.25, 1.5], [1, 0]]
	set sparks.color_gradient to [[0, 1, 1, 1, 1], [1, 0.2, 0.4, 1, 0]]
	set sparks.facing to "flat"
	set sparks.shape to "ring"
	check(length(sparks.size_curve) is 3 and sparks.size_curve[2][2] is 1.5 and sparks.color_gradient[2][5] is 0, "ParticleEmitter curves from lists")
	check(sparks.facing is "flat" and sparks.shape is "ring", "ParticleEmitter facing and ring")
	check(fails(function() set sparks.size_curve to [[2, 1]] end) and fails(function() set sparks.facing to "sideways" end), "a ParticleEmitter's curves are checked")
	sparks.stop(true)
	check(not sparks.is_playing and sparks.particle_count is 0, "ParticleEmitter stop")
	sparks.play()
	sparks.emit(3)
	check(sparks.is_playing, "ParticleEmitter play")

	set streak to thing.add_component("Trail")
	set streak.width_curve to [[0, 1], [1, 0]]
	set streak.texture_mode to "tile"
	set streak.start_color to [1, 0.5, 0, 1]
	check(length(streak.width_curve) is 2 and streak.texture_mode is "tile" and streak.emitting, "Trail properties")
	check(fails(function() set streak.texture_mode to "wrap" end) and fails(function() set streak.lifetime to 0 end), "a Trail's values are checked")
	streak.clear()
	check(streak.point_count is 0, "Trail clear")

	set ray to thing.add_component("Beam")
	set ray.end_mode to "raycast"
	set ray.length to 8
	set ray.target to nothing
	check(ray.end_mode is "raycast" and ray.length is 8 and ray.target is nothing, "Beam properties")
	check(fails(function() set ray.end_mode to "laser" end) and fails(function() set ray.segments to 0 end), "a Beam's values are checked")

	set aura to thing.add_component("EffectShape")
	set aura.shape to "dome"
	set aura.rim to 2.5
	set aura.dissolve_curve to [[0, 0], [1, 1]]
	check(aura.shape is "dome" and aura.rim is 2.5 and aura.dissolve_curve.length is 2 and aura.loop, "EffectShape properties")
	check(fails(function() set aura.shape to "pyramid" end) and fails(function() set aura.dissolve_curve to [[0, 2]] end), "an EffectShape's values are checked")
	aura.stop()
	check(aura.finished, "an EffectShape stops")
	aura.play()
	check(not aura.finished and aura.time is 0, "an EffectShape plays again")

	set mark to thing.add_component("Decal")
	set mark.size to vector(2, 0.5, 1)
	set mark.sort_order to 2
	check(close(mark.size, vector(2, 0.5, 1)) and mark.sort_order is 2 and mark.max_angle is 60, "Decal properties")
	check(fails(function() set mark.max_angle to 120 end), "a Decal's max angle is held to its range")

	check(thing.components.join(", ") is "Transform, MeshRenderer, PointLight, RigidBody, SphereCollider, AudioSource, NavAgent, ParticleEmitter, Trail, Beam, EffectShape, Decal", "components list ({thing.components})")
	thing.remove_component("PointLight")
	check(not thing.has_component("PointLight") and thing.get_component("PointLight") is nothing, "remove_component")
	thing.destroy()
end

function test_materials()
	set gold to Material("Forge Gold", [1, 0.8, 0.3, 1], 1, 0.25)
	check(gold.name is "Forge Gold" and gold.path.starts_with("Runtime/"), "runtime materials")
	set gold.metallic to 2
	set gold.emissive to vector(1, 0.2, 0)
	check(gold.metallic is 1 and close(gold.emissive, vector(1, 0.2, 0)), "material properties (metallic is clamped)")
	set loaded to Material.load("Materials/Gold.bmat")
	check(loaded.path is "Materials/Gold.bmat" and loaded.metallic is above 0.9, "Material.load")
	check(fails(function() Material.load("Materials/Missing.bmat") end), "loading a missing material fails")
	check(play_sound("Audio/Chime.wav", 0.1) and not play_sound("Audio/Missing.wav"), "play_sound")
	check(play_sound("Audio/Chime.wav", 0.1, "Music"), "play_sound on a bus")
	check(bus_names().join(", ") is "Master, Music, Effects", "bus_names")
	set_bus_volume("Music", 0.5)
	check(near(get_bus_volume("Music"), 0.5, 0.001), "set_bus_volume")
	set_bus_volume("Music", 1.0)
	set_bus_muted("Music")
	check(is_bus_muted("Music"), "set_bus_muted")
	set_bus_muted("Music", false)
	check(not is_bus_muted("Music"), "unmuting a bus")
	check(fails(function() set_bus_volume("Nowhere", 1) end), "unknown buses are rejected")
end

function test_screenshots()
	set folder to user folder
	check(folder is user_folder() and folder.ends_with("Feature Test"), "user folder ({folder})")
	set shot to save screenshot to "FeatureTest/forge.png"
	check(shot.starts_with(folder) and shot.ends_with("forge.png"), "save screenshot to ({shot})")
	check(save_screenshot("FeatureTest/forge.jpg", 320).ends_with("forge.jpg"), "save_screenshot as JPEG")
	check(fails(function() save screenshot to "FeatureTest/forge.bmp" end), "unsupported screenshot formats are rejected")
end

function test_pause()
	check(not the game is paused and not is_paused(), "the game starts unpaused")
	# Only the phrases are checked here: this runner isn't marked Run While Paused, so a wait while
	# paused would hold it. Held waits and time() are covered by BellowsTests.
	pause the game
	check(the game is paused and is_paused(), "pause the game")
	resume the game
	check(not the game is paused and not is_paused(), "resume the game")
	set_paused(true)
	check(the game is paused, "the game is paused follows set_paused")
	set_paused(false)
end

function test_keep_across_scenes()
	set kept to create_entity("Kept")
	check(not kept.keep_across_scenes, "a new entity isn't kept")
	keep kept across scenes
	check(kept.keep_across_scenes, "keep (entity) across scenes")
	set kept.keep_across_scenes to false
	check(not kept.keep_across_scenes, "keep_across_scenes turns off")
	kept.destroy()
end

function test_camera_shake()
	shake the camera by 0.5 over 0.2 seconds
	shake the camera by 0.2 over 1 second
	shake_camera(0.3, 0.1)
	check(fails(function() shake the camera by 20 over 1 second end), "'shake the camera' refuses a strength over 10")
	check(fails(function() shake_camera(1, 11) end), "shake_camera refuses more than 10 seconds")
end

function test_tags()
	set guard to create_entity("Forge Guard")
	set scout to create_entity("Forge Scout")
	tag guard as "forge enemy"
	tag scout as "forge enemy"
	tag guard as "forge enemy"
	check(guard.tags is ["forge enemy"] and scout.has_tag("forge enemy"), "tag (entity) as (tag), each tag once")
	set found to []
	for each enemy in everything tagged "forge enemy"
		add enemy.name to found
	end
	check(found is ["Forge Guard", "Forge Scout"], "everything tagged (tag), in hierarchy order ({found})")
	check(length(find_tagged("forge enemy")) is 2, "find_tagged")
	untag scout as "forge enemy"
	check(not scout.has_tag("forge enemy") and length(everything tagged "forge enemy") is 1, "untag (entity) as (tag)")
	check(fails(function() tag guard as "" end), "an empty tag is refused")
	guard.destroy()
	scout.destroy()
end

function test_groups()
	check(group("Forge Bays") is nothing, "group (name) is nothing before it exists")
	set bays to create_group("Forge Bays", "anchor")
	set bay to create_entity("Forge Bay")
	set arm to create_entity("Forge Bay Arm", bay)
	check(bays.add_entity(bay) and not bays.add_entity(bay), "add_entity files a top-level entity once")
	check(bay.group is bays and arm.is_in_group("forge bays") and group("FORGE BAYS") is bays, "a child follows its parent's group, in any letter case")
	set found to []
	for each entity in bays.all_entities()
		add entity.name to found
	end
	check(found is ["Forge Bay", "Forge Bay Arm"], "all_entities ({found})")
	check(fails(function() bays.add_entity(arm) end), "a child can't be filed by itself")
	set bay.group to nothing
	check(bays.entities().is_empty() and bay.group is nothing, "setting group to nothing")
	bays.delete()
	check(not bays.valid, "delete")
	bay.destroy()
end

function test_group_phrases()
	set yard to create_group("Forge Yard", "flag")
	set crane to create_entity("Forge Crane")
	set hook to create_entity("Forge Crane Hook", crane)
	put crane in group "forge yard"
	check(crane.group is yard and group "Forge Yard" has hook, "put (entity) in group (name), and a child is in its parent's group")
	check(length(everything in group "Forge Yard") is 1 and length(everything under group "Forge Yard") is 2, "everything in / under group (name)")
	remove crane from group "Forge Yard"
	check(crane.group is nothing and not (group "Forge Yard" has crane), "remove (entity) from group (name)")
	check(fails(function() put crane in group "Forge Yrd" end), "a misspelled group name is an error")
	yard.delete()
	crane.destroy()
end

function test_particle_phrases()
	set torch to create_entity("Forge Torch")
	set flame to torch.add_component("ParticleEmitter")
	set flame.play_on_start to false
	set flame.rate to 0
	play particles on torch
	check(the particles on torch are playing, "play particles on (entity)")
	pause particles on torch
	check(not (the particles on torch are playing), "pause particles on (entity)")
	emit 12 particles from torch
	wait 1 frame
	check(flame.particle_count is 12, "emit (count) particles from (entity) ({flame.particle_count})")
	clear particles on torch
	check(flame.particle_count is 0, "clear particles on (entity)")
	check(fails(function() play particles on find_entity("Ground") end), "a particle phrase on an entity with no ParticleEmitter is an error")

	# A mark painted where a ray meets the ground faces up, and sized marks keep their size.
	set hit to raycast(vector(-3, 10, 6), vector(0, -1, 0), 100)
	set mark to paint "Textures/TargetMark.png" at hit sized 0.5
	check(near(mark.position, hit.point, 0.001) and near(mark.up, vector(0, 1, 0), 0.001), "paint (image) at (hit) sits on the surface, facing it")
	check(mark.get_component("Decal").texture is "Textures/TargetMark.png" and near(mark.get_component("Decal").size, vector(0.5, 0.25, 0.5), 0.0001), "paint (image) at (place) sized (size)")
	check(fails(function() paint "Textures/NoSuchMark.png" at hit end), "painting a missing image is an error")
	mark.destroy()
	torch.destroy()
end

function test_data_files()
	set data to the data in "Data/FeatureData.json"
	check(data["name"] is "FeatureTest data" and data["levels"][2]["title"] is "Caves", "the data in (path) reads a JSON data file")
	check(data["secret"] is nothing and data["hard_mode"] is false, "JSON null and false")
	check(load_json("Data/FeatureData.json")["levels"][1]["enemies"] is 3, "load_json")
	check(load_text("Data/FeatureData.json").starts_with("\{"), "load_text")
	check(fails(function() load_text("../FeatureTest.bproject") end), "data files can't be read from outside Assets")
end

function test_saved_data()
	delete_data("Feature Test")
	check(load_data("Feature Test", 7) is 7, "load_data gives the default when nothing is saved")
	set progress to { credits: 12.5, ships: ["Comet", "Nova"], spawn: vector(1, 2, 3), docked: true, captain: nothing }
	check(save_data("Feature Test", progress) and has_data("Feature Test"), "save_data and has_data")
	set loaded to load_data("Feature Test")
	check(loaded is progress and loaded.spawn.y is 2, "load_data gives back what was saved ({loaded})")
	check(fails(function() save_data("Feature Test", [self]) end), "entities can't be saved")
	check(fails(function() save_data("../Feature Test", 1) end), "save names stay in the Saves folder")
	check(delete_data("Feature Test") and not has_data("Feature Test"), "delete_data")
	check(real_time() > 1700000000, "real_time is seconds since 1970 ({real_time()})")
end

function test_destruction()
	set temporary to create_entity("Forge Temporary")
	destroy(temporary)
	check(temporary.valid, "destroy is deferred to the end of the frame")
	wait 1 frame
	check(not temporary.valid, "destroyed entities become invalid")
	check(fails(function() say temporary.name end), "using a destroyed entity fails")
end

function test_physics()
	set ball to instantiate("Prefabs/Ball.bprefab", vector(-6, 4, -6))
	set ball.name to "Forge Drop Ball"
	set body to ball.get_component("RigidBody")
	set landed to function() return ball.position.y is below 0.5 end
	wait_for(landed, 4)
	check(landed(), "a dropped prefab falls onto the ground ({ball.position})")
	set body.velocity to vector(0, 5, 0)
	check(near(body.velocity, vector(0, 5, 0), 0.001), "RigidBody velocity")
	wait 2 frames
	check(ball.position.y is above 0.4, "velocity moves the body")
	set body.velocity to vector(0, 0, 0)
	push ball by vector(0, 6 * body.mass, 0)
	wait 1 frame
	check(body.velocity.y is above 4, "push gives a RigidBody a sudden push ({body.velocity})")

	set hit to raycast(vector(-3, 10, 6), vector(0, -1, 0), 100)
	check(hit is not nothing and hit.entity.name is "Ground", "raycast hits the ground")
	check(near(hit.distance, 10, 0.01) and near(hit.normal, vector(0, 1, 0), 0.001), "raycast distance and normal")
	check(raycast(vector(0, 50, 0), vector(0, 1, 0), 10) is nothing, "raycast misses give nothing")
	ball.destroy()
end

function test_events()
	check(events.contains("update"), "when update runs every frame")
	check(events.contains("physics"), "when physics update runs")

	# Contacts arrive through the trigger zone's events; the visitor's script reports back.
	set zone to find_entity("Trigger Zone")
	set visitor to create_entity("Forge Visitor")
	set visitor.position to zone.position + vector(0, 6, 0)
	visitor.add_component("RigidBody")
	visitor.add_component("SphereCollider")
	set script to visitor.add_component("Script")
	set script.path to "Scripts/ForgeVisitor.forge"
	wait_for(function() return events.contains("entered Trigger Zone") and events.contains("collided") end, 6)
	check(events.contains("entered Trigger Zone"), "scripts added during play start, and 'when entered by' runs ({events})")
	check(events.contains("collided"), "'when collided with' runs when the visitor lands")
	visitor.destroy()
	wait 1 frame
	check(events.contains("visitor destroyed"), "'when destroyed' runs")
end

when visitor reports with what
	add what to events
end

function test_tweens()
	set box to create_entity("Forge Tween Box")
	set box.position to vector(0, 0, 0)
	set glide to tween(box, "position", vector(2, 0, 0), 0.25, "out")
	check(glide.running and glide.property is "position", "tween returns a running Tween")
	wait until glide.finished or not glide.running
	check(glide.finished and close(box.position, vector(2, 0, 0)), "wait until a tween's finished, then it is at its target")
	wait 1 frame
	check(events.contains("tween finished position"), "'when tween finished' runs with the entity, property and id")
	set grow to tween_by(box, "scale", vector(1, 1, 1), 5, "linear", 1)
	check(grow.complete() and close(box.scale, vector(2, 2, 2)), "tween_by adds to the property")
	box.add_component("UIRect")
	box.add_component("UIImage")
	set tint to tween(box, "UIImage.color", [1, 1, 1, 0], 5)
	check(tint.running and stop_tweens(box) is 1 and not tint.finished, "colors tween from a list, and stop_tweens stops them")
	check(fails(function() tween(box, "position", 5, 1) end), "a tween's value must fit its property")
	set slide to move box to vector(0, 3, 0) over 0.2 seconds with "linear"
	wait until slide.finished or not slide.running
	check(slide.finished and close(box.position, vector(0, 3, 0)), "'move (entity) to (position) over (seconds) seconds with (style)' gives back the Tween")
	set shrink to scale box to 1 over 0.1 seconds
	wait until shrink.finished or not shrink.running
	check(close(box.scale, vector(1, 1, 1)), "'scale (entity) to (a number)' scales every axis ({box.scale})")
	set dim to fade box to 0.5 over 0.1 second
	wait until dim.finished or not dim.running
	check(near(box.get_component("UIImage").color, [1, 1, 1, 0.5], 0.001), "'fade' keeps the color and changes its alpha")
	box.destroy()
end

# The scene's navmesh: a pedestal stands between (0, 0, -5) and (0, 0, -1).
function test_navigation()
	set path to find_path(vector(0, 0, -5), vector(0, 0, -1))
	check(length(path) is at least 3 and near(path[length(path)], vector(0, 0, -1), 0.2), "find_path around a pedestal")
	check(is_navigable(vector(3, 0, 3)) and not is_navigable(vector(0, 0, -3)), "is_navigable")
	check(nearest_navigable_point(vector(0, 0, 500)) is nothing, "nearest_navigable_point gives nothing far away")
	check(fails(function() nearest_navigable_point(vector(0, 0, 0), -1) end), "nearest_navigable_point refuses a negative search")
	set corners to the path from vector(0, 0, -5) to vector(0, 0, -1)
	check(length(corners) is length(path), "'the path from (start) to (end)' is find_path")

	# The Guard walks the open ground in front of the camera.
	set guard to find_entity("Guard")
	set agent to guard.get_component("NavAgent")
	check(walk guard to vector(0, 0, 7), "'walk (entity) to (position)' finds navmesh there")
	check(agent.moving, "the Guard is on its way")
	wait_for(function() return events.contains("Guard reached it") end, 6)
	check(events.contains("Guard reached it") and not agent.moving and near(guard.position, vector(0, 0.9, 7), 0.15),
		"when destination reached with who, reached ({guard.position})")
	walk guard to vector(-3, 0, 7)
	wait 10 frames
	halt guard
	check(not agent.moving and agent.destination is nothing, "'halt (entity)' stops it")
	check(not (walk guard to vector(0, 0, 500)), "'walk' gives back false where there's no navmesh")
	set plain to create_entity("Forge Plain Walker")
	check(fails(function() walk plain to vector(0, 0, 7) end), "'walk' needs an entity with a NavAgent")
	plain.destroy()
end

when destination reached with who, reached
	if who.valid and who.name is "Guard" and reached then add "Guard reached it" to events end
end

# 'label' is an Inspector field ("authored" in the scene): changing it tells every script.
function test_field_changed()
	set label to "changed"
	set label to "changed"
	wait_for(function() return events.contains("label: authored to changed") end, 2)
	check(events.contains("label: authored to changed"), "when field changed with who, field, now, before")
	check(events.count("label: authored to changed") is 1, "setting the same value again changes nothing")
	check(events.contains("only mine: label"), "when \"ForgeScript Test Runner\" is field changed hears this entity's changes")
	set label to "authored"
end

when field changed with who, field, now, before
	if who is self and field is "label" then add "label: {before} to {now}" to events end
end

when "ForgeScript Test Runner" is field changed with who, field, now, before
	if field is "label" then add "only mine: {field}" to events end
end

# The Dancer plays SkinnedColumn.glb's clips, "Bend" and "Wave".
function test_animation()
	set dancer to find_entity("Dancer")
	set animator to dancer.get_component("Animator")
	check(animator.clips is ["Bend", "Wave"] and animator.clip is "Wave", "the Dancer's Animator plays its start clip")
	play animation "Bend" on dancer
	check(animator.clip is "Bend" and animator.playing, "play animation (clip) on (entity)")
	wait 2 frames
	pause animation on dancer
	set held to animator.time
	wait 2 frames
	check(not animator.playing and close(animator.time, held), "pause animation on (entity)")
	resume animation on dancer
	check(animator.playing, "resume animation on (entity)")
	check(fails(function() play animation "Dance" on dancer end), "'play animation' refuses a clip the model doesn't have")
	set plain to create_entity("Forge Plain")
	check(fails(function() pause animation on plain end), "'pause animation' needs an entity with an Animator")
	plain.destroy()
	check(near(animator.bone_position("Top"), dancer.position + vector(0, 1, 0), 0.001), "bone_position: Top turns at the knee")

	set animator.loop to false
	animator.play("Wave", 0)
	set animator.time to 0.9
	wait_for(function() return events.contains("animation finished Wave") end, 2)
	check(events.contains("animation finished Wave"), "when animation finished with who, clip")
	set animator.loop to true
	play animation "Wave" on dancer
end

when animation finished with who, clip
	if who.valid and who.name is "Dancer" then add "animation finished {clip}" to events end
end

when tween finished with who, property, id
	if who.valid and who.name is "Forge Tween Box" then add "tween finished {property}" to events end
end

function run_tests()
	try
		test_basics()
		test_scene_queries()
		test_entities()
		test_components()
		test_materials()
		test_screenshots()
		test_pause()
		test_keep_across_scenes()
		test_tags()
		test_groups()
		test_group_phrases()
		test_particle_phrases()
		test_camera_shake()
		test_data_files()
		test_saved_data()
		test_destruction()
		test_physics()
		test_events()
		test_tweens()
		test_animation()
		test_navigation()
		test_field_changed()
	catch problem
		add "unexpected error: {problem}" to failures
	end
	# Entities destroyed by the tests disappear at the end of this frame, before Python runs.
	wait 1 frame
	if failures.is_empty() then
		say "ForgeScript feature test passed ({checks} checks)"
		set my name to "ForgeScript Test Passed ({checks} checks)"
	else
		say "ForgeScript feature test failed: {length(failures)} of {checks} checks"
		for each failure in failures
			say "  - {failure}"
		end
		set my name to "ForgeScript Test Failed ({length(failures)} of {checks} checks)"
	end
end

when created
	# Wait a few frames so the update and physics events have run at least once.
	wait 3 frames
	run_tests()
end
