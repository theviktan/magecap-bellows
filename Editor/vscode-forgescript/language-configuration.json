{
	"comments": {
		"lineComment": "#",
		"blockComment": ["#[", "]#"]
	},
	"brackets": [["(", ")"], ["[", "]"], ["{", "}"]],
	"autoClosingPairs": [
		{ "open": "(", "close": ")" },
		{ "open": "[", "close": "]" },
		{ "open": "{", "close": "}" },
		{ "open": "\"", "close": "\"", "notIn": ["string"] }
	],
	"surroundingPairs": [["(", ")"], ["[", "]"], ["{", "}"], ["\"", "\""]],
	"indentationRules": {
		"increaseIndentPattern": "^\\s*(if|else|otherwise|while|until|repeat|for|function|phrase|kind|when|try|catch)\\b.*$",
		"decreaseIndentPattern": "^\\s*(end|else|otherwise|catch)\\b"
	},
	"wordPattern": "[A-Za-z_][A-Za-z0-9_]*"
}
