{
	"name": "forge-language",
	"displayName": "Forge Language",
	"description": "Syntax highlighting for the Forge scripting language (.forge files).",
	"version": "1.0.0",
	"publisher": "magecap-games",
	"engines": { "vscode": "^1.80.0" },
	"categories": ["Programming Languages"],
	"contributes": {
		"languages": [
			{
				"id": "forge",
				"aliases": ["Forge", "forge"],
				"extensions": [".forge"],
				"configuration": "./language-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "forge",
				"scopeName": "source.forge",
				"path": "./syntaxes/forge.tmLanguage.json"
			}
		]
	}
}
