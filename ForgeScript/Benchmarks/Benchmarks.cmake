# Runs every benchmark and compares the instructions it executes with instructions.txt. Instruction
# counts are the same on every machine, so this never fails because CI was slow; times are printed
# only. Run by ctest:
#   cmake -DFORGESCRIPT=<forgescript> -DFOLDER=<this folder> -P Benchmarks.cmake

cmake_minimum_required(VERSION 3.24)

file(GLOB scripts "${FOLDER}/*.forge")
list(SORT scripts)
execute_process(COMMAND "${FORGESCRIPT}" --benchmark ${scripts}
	RESULT_VARIABLE exitCode OUTPUT_VARIABLE out ERROR_VARIABLE err)
message(STATUS "\n${out}")
if(NOT exitCode EQUAL 0)
	message(FATAL_ERROR "forgescript --benchmark failed (${exitCode}):\n${err}")
endif()

file(STRINGS "${FOLDER}/instructions.txt" baseline REGEX "^[^#]")
set(failures "")
set(measured 0)
string(REPLACE "\n" ";" lines "${out}")
foreach(line IN LISTS lines)
	if(NOT line MATCHES "^([^ ]+) instructions ([0-9]+) median")
		continue()
	endif()
	set(name "${CMAKE_MATCH_1}")
	set(count "${CMAKE_MATCH_2}")
	math(EXPR measured "${measured} + 1")
	set(expected "")
	foreach(entry IN LISTS baseline)
		if(entry MATCHES "^${name} ([0-9]+)$")
			set(expected "${CMAKE_MATCH_1}")
		endif()
	endforeach()
	if(expected STREQUAL "")
		list(APPEND failures "${name} has no line in instructions.txt; add: ${name} ${count}")
		continue()
	endif()
	math(EXPR limit "${expected} + ${expected} / 20")
	math(EXPR floor "${expected} - ${expected} / 20")
	if(count GREATER limit)
		list(APPEND failures "${name} ran ${count} instructions, more than 5% over its ${expected}: something made scripts slower")
	elseif(count LESS floor)
		message(STATUS "${name} now runs ${count} instructions instead of ${expected}. Lower its line in instructions.txt to keep the gain.")
	endif()
endforeach()

list(LENGTH scripts total)
if(NOT measured EQUAL total)
	list(APPEND failures "Only ${measured} of ${total} benchmarks reported a count")
endif()
if(failures)
	list(JOIN failures "\n" all)
	message(FATAL_ERROR "${all}")
endif()
