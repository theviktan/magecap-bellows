{
	"name": "forgescript",
	"displayName": "ForgeScript",
	"description": "Syntax highlighting for the ForgeScript scripting language (.forge files).",
	"version": "1.1.0",
	"publisher": "magecap-games",
	"icon": "icon.png",
	"engines": { "vscode": "^1.80.0" },
	"categories": ["Programming Languages"],
	"contributes": {
		"languages": [
			{
				"id": "forgescript",
				"aliases": ["ForgeScript", "forgescript"],
				"extensions": [".forge"],
				"configuration": "./language-configuration.json",
				"icon": { "light": "./icon.png", "dark": "./icon.png" }
			}
		],
		"grammars": [
			{
				"language": "forgescript",
				"scopeName": "source.forge",
				"path": "./syntaxes/forgescript.tmLanguage.json"
			}
		]
	}
}
