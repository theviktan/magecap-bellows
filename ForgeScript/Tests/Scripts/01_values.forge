# Numbers, text, truth values and nothing.
say 42                          # expect: 42
say 3.5                         # expect: 3.5
say 1_000_000                   # expect: 1000000
say 0xFF                        # expect: 255
say 2.5e3                       # expect: 2500
say -7                          # expect: -7
say 10 / 4                      # expect: 2.5
say 7 % 3                       # expect: 1
say -7 % 3                      # expect: 2
say 2 ^ 10                      # expect: 1024
say 2 ^ 3 ^ 2                   # expect: 512
say -2 ^ 2                      # expect: -4
say (1 + 2) * 3                 # expect: 9
say 1 + 2 * 3                   # expect: 7
say 0.1 + 0.2                   # expect: 0.3
say true                        # expect: true
say no                          # expect: false
say yes                         # expect: true
say nothing                     # expect: nothing
say "Hello"                     # expect: Hello
say "Tab\there"                 # expect: Tab	here
say "Quote: \"hi\""             # expect: Quote: "hi"
say "Braces: \{not code\}"      # expect: Braces: {not code}
say "a" + "b"                   # expect: ab
say "Score: " + 10              # expect: Score: 10
say "ha" * 3                    # expect: hahaha
say not true                    # expect: false
say not nothing                 # expect: true
say 0 is 0.0                    # expect: true
#[ block comments
   are ignored ]#
say "after comment"             # expect: after comment
set long to 1 +
	2 +
	3
say long                        # expect: 6
set joined to 10 \
	* 2
say joined                      # expect: 20
