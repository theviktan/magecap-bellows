# ForgeScript 1.6 built-ins: easing, noise, colors, more random, and text and list helpers.

# Easing: 0 at the start, 1 at the end, a curve between.
say ease(0, "in")                           # expect: 0
say ease(1, "out")                          # expect: 1
say ease(0.5, "linear")                     # expect: 0.5
say ease(0.5, "in")                         # expect: 0.125
say ease(0.5, "out")                        # expect: 0.875
say ease(0.5, "in out")                     # expect: 0.5
say ease(0.25, "In Out")                    # expect: 0.0625
say round(ease(0.5, "sine in out"), 6)      # expect: 0.5
say ease(0.8, "back out") > 1               # expect: true
say ease(0.2, "back in") < 0                # expect: true
say ease(1, "bounce out")                   # expect: 1
say ease(1, "elastic out")                  # expect: 1
say ease(2, "in")                           # expect: 1
say ease(-1, "out")                         # expect: 0

# Noise: smooth, from -1 to 1, the same every time.
say noise(1.5) is noise(1.5)                # expect: true
say noise(2, 3, 4) is 0                     # expect: true
say noise(vector(0.3, 0.7, 1.1)) is noise(0.3, 0.7, 1.1)   # expect: true
say abs(noise(10.01) - noise(10)) < 0.05    # expect: true
random_seed(1)
set before to noise(4.2)
random_seed(99)
say noise(4.2) is before                    # expect: true
set lowest to 1
set highest to -1
for i from 1 to 2000 do
	set n to noise(i * 0.13, i * 0.07)
	set lowest to min(lowest, n)
	set highest to max(highest, n)
end
say lowest >= -1 and highest <= 1           # expect: true
say lowest < -0.3 and highest > 0.3         # expect: true
say noise(1e15) >= -1                       # expect: true

# Colors are [r, g, b, a] lists from 0 to 1.
say color(1, 0.5, 0)                        # expect: [1, 0.5, 0, 1]
say color(0, 0, 0, 0.25)                    # expect: [0, 0, 0, 0.25]
say color("#ff0000")                        # expect: [1, 0, 0, 1]
say color("00ff0080")[4] is 128 / 255       # expect: true
say color("#fff")                           # expect: [1, 1, 1, 1]
say color("#0f08")                          # expect: [0, 1, 0, 0.53333333333333]
say hsv(0, 1, 1)                            # expect: [1, 0, 0, 1]
say hsv(1 / 3, 1, 1)                        # expect: [0, 1, 0, 1]
say hsv(2 / 3, 1, 1)                        # expect: [0, 0, 1, 1]
say hsv(1, 1, 1)                            # expect: [1, 0, 0, 1]
say hsv(0.5, 0, 0.5, 0.5)                   # expect: [0.5, 0.5, 0.5, 0.5]
say hsv(-0.5, 1, 1)                         # expect: [0, 1, 1, 1]

# More random, following random_seed.
random_seed(5)
set rolls to []
repeat 5 times
	add random_chance(0.5) to rolls
end
random_seed(5)
set again to []
repeat 5 times
	add random_chance(0.5) to again
end
say rolls is again                          # expect: true
say random_chance(0)                        # expect: false
say random_chance(1)                        # expect: true
say round(random_direction().length, 9)     # expect: 1
set point to random_point_in_circle(3)
say point.y                                 # expect: 0
say point.length <= 3                       # expect: true
say random_point_in_circle(0)               # expect: (0, 0, 0)

# Text helpers.
say "sword of fire".capitalize()            # expect: Sword of fire
say "".capitalize()                         # expect:
say "sword  of\tfire".title()               # expect: Sword  Of	Fire
say "banana".count("an")                    # expect: 2
say "aaaa".count("aa")                      # expect: 2
say "banana".count("x")                     # expect: 0

# List helpers.
say [3, 1, 3, 2, 1].unique()                # expect: [3, 1, 2]
say ["a", "b", "a"].unique()                # expect: ["a", "b"]
say [[1], [1], [2], 0, -0].unique()         # expect: [[1], [2], 0]
say [[1, 2], [3], 4, []].flatten()          # expect: [1, 2, 3, 4]
say [[[1]]].flatten()                       # expect: [[1]]
say [1, 2, 3, 4, 5].chunk(2)                # expect: [[1, 2], [3, 4], [5]]
say [].chunk(3)                             # expect: []
set words to ["aa", "b", "cccc", "dddd"]
say words.max_by(function(w) return w.length end)     # expect: cccc
say words.min_by(function(w) return w.length end)     # expect: b
say [].max_by(function(w) return w end)               # expect: nothing

# Mistakes say what to write instead.
function problem_of(action)
	try
		action()
	catch problem
		return problem
	end
	return "no problem"
end
say problem_of(function() hsv(1, 1) end)                 # expect: hsv needs hue, saturation and value (and alpha) from 0 to 1, like: hsv(0.6, 1, 1)
say problem_of(function() color("#ff88") end)            # expect: no problem
say problem_of(function() color("orange") end)           # expect: 'orange' isn't a color. Write it like "#ff8800" (red, green, blue) or "#ff880080" (with alpha).
say problem_of(function() color(1, 2) end)               # expect: color needs red, green and blue (and alpha) from 0 to 1, like: color(1, 0.5, 0), or a text like color("#ff8800").
say problem_of(function() noise() end)                   # expect: noise needs 1, 2 or 3 numbers, like: noise(x) or noise(x, y)
say problem_of(function() random_point_in_circle(-1) end)   # expect: random_point_in_circle needs a radius of 0 or more.
say problem_of(function() "x".count("") end)             # expect: count needs some text to look for, like: line.count("a")
say problem_of(function() [1].chunk(0) end)              # expect: chunk needs a size of 1 or more, like: items.chunk(3)
say problem_of(function() [1].max_by(5) end)             # expect: max_by needs a function that gives a number for each item, like: enemies.max_by(function(enemy) return enemy.health end)
say problem_of(function() ["a"].min_by(function(w) return w end) end)   # expect: min_by's function must give a number for each item, but gave text.

# Edge cases that must give a mistake (or a plain answer), never a hang or a crash.
set loop to [1]
add loop to loop
say loop.flatten().length                                   # expect: 3
say [1, 2, 3].chunk(1e18)                                   # expect: [[1, 2, 3]]
say problem_of(function() [1].chunk(-1) end)                # expect: chunk needs a size of 1 or more, like: items.chunk(3)
say problem_of(function() [1].chunk(0.5) end)               # expect: chunk needs a whole number for value 1, but got 0.5.
say problem_of(function() [1].chunk(infinity) end)          # expect: chunk needs a whole number between -9.2e18 and 9.2e18 for value 1, but got infinity.
say problem_of(function() noise(infinity) end)              # expect: noise needs ordinary numbers, but value 1 is infinity.
say problem_of(function() noise(1, infinity - infinity) end)   # expect: noise needs ordinary numbers, but value 2 is not a number.
say problem_of(function() noise(vector(infinity, 0, 0)) end)   # expect: noise needs ordinary numbers, but the position has infinity or not a number in it.
say problem_of(function() hsv(infinity - infinity, 1, 1) end)  # expect: hsv needs ordinary numbers, but value 1 is not a number.
say problem_of(function() ease(infinity, "in") end)         # expect: ease needs ordinary numbers, but value 1 is infinity.
say problem_of(function() random_point_in_circle(infinity) end)   # expect: random_point_in_circle needs ordinary numbers, but value 1 is infinity.
say problem_of(function() random(infinity) end)             # expect: random needs a whole number between -9.2e18 and 9.2e18 for value 1, but got infinity.
set refused to 0
for each bad in ["#", "#ff", "#gggggg", "#ff00ff00f", "-fff", "+fff", "#ff 0f0", "#" + "f".repeat(5000)] do
	if problem_of(function() color(bad) end).starts_with("'") then add 1 to refused end
end
say refused                                                 # expect: 8
say "émile".capitalize()                                    # expect: émile
say "été à paris".title()                                   # expect: été à Paris

# A script's own names still win over the new built-ins.
function own_ease()
	set ease to function(t) return "mine" end
	return ease(0.5)
end
say own_ease()                              # expect: mine
set color to "blue"
say color                                   # expect: blue
