# 'is a function' tests a value's type. Inside a function it used to be read as the start of a block,
# so the rest of the script after that function silently never ran.
function check(value)
	if value is a function then return "function" end
	return "not"
end
say check(print)                            # expect: function
say check(3)                                # expect: not

function nested()
	say print is a function                  # expect: true
	say 3 is not an function                 # expect: true
	return "after"
end
say nested()                                # expect: after

kind Box
	function holds_code(value)
		return value is a function
	end
end
say new Box().holds_code(nested)            # expect: true
say "the end of the script runs"            # expect: the end of the script runs
