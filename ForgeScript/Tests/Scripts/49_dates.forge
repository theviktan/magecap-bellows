# Dates and the real clock: real_time, date, utc_date, format_date and days_between.

# real_time() is seconds since 1970 by the computer's clock, and keeps going on its own.
set started to real_time()
say started > 1.7e9                                         # expect: true
say real_time() >= started                                  # expect: true

# utc_date gives the same answer on every computer.
say utc_date(0)                                             # expect: {"year": 1970, "month": 1, "day": 1, "hour": 0, "minute": 0, "second": 0, "weekday": "Thursday", "weekday_number": 4, "month_name": "January", "day_of_year": 1}
set leap to utc_date(951782400)
say [leap.year, leap.month, leap.day, leap.weekday, leap.day_of_year]   # expect: [2000, 2, 29, "Tuesday", 60]
set moment to utc_date(1795437296)
say [moment.year, moment.month, moment.day, moment.hour, moment.minute, moment.second]   # expect: [2026, 11, 23, 12, 34, 56]
say moment.weekday + ", " + moment.month_name               # expect: Monday, November
say utc_date(253402300799).year                             # expect: 9999
say utc_date(1704067199.9).second                           # expect: 59

# date() is local time: the same fields, in the computer's own time zone.
set here to date(1795437296)
# Time zones are whole hours, or 30 or 45 minutes off.
say (here.minute - 34) % 15 is 0 and here.second is 56      # expect: true
say date().year >= 2026                                     # expect: true

# format_date writes a moment in local time, by pattern words.
set parts to date(1795437296)
function two(n)
	return ("0" if n < 10 otherwise "") + n
end
say format_date(1795437296, "YYYY-MM-DD") is "{parts.year}-{two(parts.month)}-{two(parts.day)}"   # expect: true
say format_date(1795437296) is "{parts.year}-{two(parts.month)}-{two(parts.day)} {two(parts.hour)}:{two(parts.minute)}"   # expect: true
say format_date(1795437296, "Weekday Wkd Month Mon") is "{parts.weekday} {parts.weekday.slice(1, 3)} {parts.month_name} {parts.month_name.slice(1, 3)}"   # expect: true
say format_date(0, "Day one, nothing to replace!").length > 0   # expect: true

# days_between counts calendar days in local time.
say days_between(1795437296, 1795437296)                    # expect: 0
set ten to days_between(1795437296, 1795437296 + 864000)
say ten >= 9 and ten <= 11                                  # expect: true
say days_between(1795437296 + 864000, 1795437296) < 0       # expect: true

# Mistakes say what to write instead.
function problem_of(action)
	try
		action()
	catch problem
		return problem
	end
	return "no problem"
end
say problem_of(function() date(-1) end)                     # expect: date needs a moment from real_time(): seconds from 1970 to the end of 9999, but got -1.
say problem_of(function() utc_date(1e13) end)               # expect: utc_date needs a moment from real_time(): seconds from 1970 to the end of 9999, but got 10000000000000.
say problem_of(function() format_date(infinity) end)        # expect: format_date needs a moment from real_time(): seconds from 1970 to the end of 9999, but got infinity.
say problem_of(function() days_between(0, infinity - infinity) end).starts_with("days_between needs a moment")   # expect: true
say problem_of(function() date(1, 2) end)                   # expect: date takes one moment from real_time() at most, like: date(saved_at)
say problem_of(function() format_date() end)                # expect: format_date needs a moment from real_time() and maybe a pattern, like: format_date(real_time(), "YYYY-MM-DD")

# A script's own names still win over the new built-ins.
function own_date()
	set date to "my date"
	return date
end
say own_date()                                              # expect: my date
