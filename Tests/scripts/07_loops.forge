set count to 0
while count is below 3 do
	add 1 to count
end
say count                         # expect: 3
until count is 0 do
	take 1 from count
end
say count                         # expect: 0
repeat 3 times
	add 2 to count
end
say count                         # expect: 6
set total to 0
for i from 1 to 5 do
	add i to total
end
say total                         # expect: 15
for i from 10 to 0 by -5 do
	say i
end
# expect: 10
# expect: 5
# expect: 0
for i from 3 to 1 do
	say i
end
# expect: 3
# expect: 2
# expect: 1
for i from 0 to 1 by 0.5 do say i end
# expect: 0
# expect: 0.5
# expect: 1
for each n in [1, 2, 3, 4, 5, 6] do
	if n is 2 then skip end
	if n is 5 then stop end
	say n
end
# expect: 1
# expect: 3
# expect: 4
set laps to 0
repeat forever
	add 1 to laps
	if laps is 4 then stop end
end
say laps                          # expect: 4
for i from 1 to 3 do
	for j from 1 to 3 do
		if j is 2 then skip end
		if i is 2 then stop end
		say "{i},{j}"
	end
end
# expect: 1,1
# expect: 1,3
# expect: 3,1
# expect: 3,3
set fns to []
for each n in [1, 2, 3] do
	add function() return n * 10 end to fns
end
for each f in fns do say f() end
# expect: 10
# expect: 20
# expect: 30
for i from 1 to 3 do
	set kept to i
	if i is 2 then
		for each x in [1] do
			skip
		end
	end
end
say kept                          # expect: 3
for each item, position in ["a", "b"] do say "{position}:{item}" end
# expect: 1:a
# expect: 2:b
repeat 0 times say "never" end
for each x in [] do say "never" end
say "done"                        # expect: done
